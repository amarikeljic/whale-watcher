# Copy to ".env" and fill in. Never commit .env.
#
# This service never trades, so there is nothing here that can move money:
# no wallet keys, no seed phrases, no exchange API credentials. If a future
# change asks for one, that change is wrong.

# Discord webhook for alerts (Server Settings -> Integrations -> Webhooks).
# Leave empty to run without posting: alerts are still detected and stored,
# and paper trades still run, which is useful for a dry run.
DISCORD_WEBHOOK_URL=

# Optional second webhook for the daily stats summary.
DISCORD_STATS_WEBHOOK_URL=

# Optional overrides
# WHALEWATCHER_CONFIG=config.yaml
# WHALEWATCHER_DB=data/whalewatcher.sqlite3
# LOG_LEVEL=INFO
